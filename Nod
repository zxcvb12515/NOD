<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Калькулятор НОД - 6 класс</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .container {
            background: white;
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            max-width: 900px;
            width: 100%;
            padding: 40px;
        }

        h1 {
            text-align: center;
            color: #667eea;
            margin-bottom: 10px;
            font-size: 2.5em;
        }

        .subtitle {
            text-align: center;
            color: #666;
            margin-bottom: 30px;
            font-size: 1.1em;
        }

        .input-section {
            display: flex;
            gap: 20px;
            margin-bottom: 30px;
            flex-wrap: wrap;
        }

        .input-group {
            flex: 1;
            min-width: 200px;
        }

        label {
            display: block;
            margin-bottom: 8px;
            color: #333;
            font-weight: 600;
            font-size: 1.1em;
        }

        input[type="number"] {
            width: 100%;
            padding: 15px;
            border: 3px solid #e0e0e0;
            border-radius: 10px;
            font-size: 1.2em;
            transition: border-color 0.3s;
        }

        input[type="number"]:focus {
            outline: none;
            border-color: #667eea;
        }

        .buttons {
            display: flex;
            gap: 15px;
            margin-bottom: 30px;
            flex-wrap: wrap;
        }

        button {
            flex: 1;
            min-width: 150px;
            padding: 15px 30px;
            border: none;
            border-radius: 10px;
            font-size: 1.1em;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
        }

        .btn-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);
        }

        .btn-secondary {
            background: #f0f0f0;
            color: #333;
        }

        .btn-secondary:hover {
            background: #e0e0e0;
        }

        .btn-example {
            background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
            color: white;
        }

        .btn-example:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(245, 87, 108, 0.4);
        }

        .error-message {
            background: #fee;
            border: 2px solid #fcc;
            color: #c33;
            padding: 15px;
            border-radius: 10px;
            margin-bottom: 20px;
            display: none;
        }

        .result-section {
            display: none;
        }

        .factorization-container {
            display: flex;
            gap: 40px;
            margin-bottom: 30px;
            flex-wrap: wrap;
            justify-content: center;
        }

        .factorization-column {
            background: #f8f9fa;
            padding: 25px;
            border-radius: 15px;
            min-width: 250px;
            flex: 1;
        }

        .factorization-title {
            text-align: center;
            font-size: 1.3em;
            font-weight: 600;
            color: #667eea;
            margin-bottom: 20px;
        }

        .factorization-step {
            display: flex;
            justify-content: space-between;
            padding: 8px 0;
            font-size: 1.2em;
            font-family: 'Courier New', monospace;
            opacity: 0;
            transform: translateX(-20px);
            transition: all 0.5s;
        }

        .factorization-step.visible {
            opacity: 1;
            transform: translateX(0);
        }

        .factorization-step .number {
            color: #333;
            font-weight: 600;
        }

        .factorization-step .divider {
            color: #999;
            margin: 0 10px;
        }

        .factorization-step .factor {
            color: #667eea;
            font-weight: 600;
        }

        .factorization-step.common .factor {
            color: #10b981;
            text-decoration: underline;
            background: #d1fae5;
            padding: 2px 8px;
            border-radius: 5px;
        }

        .multiplication-line {
            background: #fef3c7;
            border: 2px solid #fbbf24;
            padding: 20px;
            border-radius: 10px;
            margin: 20px 0;
            font-size: 1.2em;
            text-align: center;
            opacity: 0;
            transform: translateY(20px);
            transition: all 0.5s;
        }

        .multiplication-line.visible {
            opacity: 1;
            transform: translateY(0);
        }

        .result-box {
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            color: white;
            padding: 30px;
            border-radius: 15px;
            text-align: center;
            font-size: 1.5em;
            font-weight: 600;
            margin-top: 30px;
            opacity: 0;
            transform: scale(0.9);
            transition: all 0.5s;
        }

        .result-box.visible {
            opacity: 1;
            transform: scale(1);
        }

        .hint {
            background: #eff6ff;
            border-left: 4px solid #3b82f6;
            padding: 15px;
            margin-top: 20px;
            border-radius: 5px;
            color: #1e40af;
            font-size: 1em;
        }

        @media (max-width: 768px) {
            .container {
                padding: 20px;
            }

            h1 {
                font-size: 1.8em;
            }

            .factorization-container {
                flex-direction: column;
                gap: 20px;
            }

            .factorization-column {
                min-width: 100%;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>🔢 Калькулятор НОД</h1>
        <p class="subtitle">Нахождение наибольшего общего делителя двух чисел</p>

        <div class="input-section">
            <div class="input-group">
                <label for="number1">📝 Первое число (от 2 до 10 000):</label>
                <input type="number" id="number1" min="2" max="10000" placeholder="Например: 84">
            </div>
            <div class="input-group">
                <label for="number2">📝 Второе число (от 2 до 10 000):</label>
                <input type="number" id="number2" min="2" max="10000" placeholder="Например: 126">
            </div>
        </div>

        <div class="buttons">
            <button class="btn-primary" onclick="calculateGCD()">🔍 Найти НОД</button>
            <button class="btn-secondary" onclick="clearAll()">🗑️ Очистить</button>
            <button class="btn-example" onclick="showExample()">💡 Показать пример</button>
        </div>

        <div class="error-message" id="errorMessage"></div>

        <div class="result-section" id="resultSection">
            <div class="factorization-container">
                <div class="factorization-column" id="factorization1">
                    <div class="factorization-title">Разложение первого числа</div>
                </div>
                <div class="factorization-column" id="factorization2">
                    <div class="factorization-title">Разложение второго числа</div>
                </div>
            </div>

            <div class="multiplication-line" id="multiplicationLine"></div>

            <div class="result-box" id="resultBox"></div>

            <div class="hint">
                💡 <strong>Правило:</strong> НОД — это произведение общих простых множителей двух чисел.
            </div>
        </div>
    </div>

    <script>
        // Нахождение простых множителей числа
        function factorize(n) {
            const factors = [];
            let num = n;
            
            // Делим на 2
            while (num % 2 === 0) {
                factors.push(2);
                num = num / 2;
            }
            
            // Делим на нечётные числа начиная с 3
            for (let i = 3; i <= Math.sqrt(num); i += 2) {
                while (num % i === 0) {
                    factors.push(i);
                    num = num / i;
                }
            }
            
            // Если осталось число больше 2
            if (num > 2) {
                factors.push(num);
            }
            
            return factors;
        }

        // Нахождение общих множителей с учётом кратности
        function findCommonFactors(factors1, factors2) {
            const common = [];
            const copy2 = [...factors2];
            
            for (let factor of factors1) {
                const index = copy2.indexOf(factor);
                if (index !== -1) {
                    common.push(factor);
                    copy2.splice(index, 1);
                }
            }
            
            return common;
        }

        // Валидация ввода
        function validateInput(num1, num2) {
            if (isNaN(num1) || isNaN(num2)) {
                return "Пожалуйста, введите числа!";
            }
            if (num1 < 2 || num2 < 2) {
                return "Числа должны быть больше или равны 2!";
            }
            if (num1 > 10000 || num2 > 10000) {
                return "Числа не должны превышать 10 000!";
            }
            if (!Number.isInteger(num1) || !Number.isInteger(num2)) {
                return "Пожалуйста, введите целые числа!";
            }
            return null;
        }

        // Отображение разложения столбиком
        function displayFactorization(number, factors, containerId, commonFactors) {
            const container = document.getElementById(containerId);
            container.innerHTML = '<div class="factorization-title">Разложение числа ' + number + '</div>';
            
            let currentNum = number;
            let stepDelay = 0;
            
            for (let i = 0; i < factors.length; i++) {
                const factor = factors[i];
                const nextNum = currentNum / factor;
                const isCommon = commonFactors.includes(factor);
                
                const stepDiv = document.createElement('div');
                stepDiv.className = 'factorization-step' + (isCommon ? ' common' : '');
                stepDiv.innerHTML = `
                    <span class="number">${currentNum}</span>
                    <span class="divider">│</span>
                    <span class="factor">${factor}</span>
                `;
                
                container.appendChild(stepDiv);
                
                setTimeout(() => {
                    stepDiv.classList.add('visible');
                }, stepDelay);
                
                stepDelay += 300;
                currentNum = nextNum;
            }
            
            // Последняя строка с 1
            const finalStep = document.createElement('div');
            finalStep.className = 'factorization-step';
            finalStep.innerHTML = `
                <span class="number">1</span>
                <span class="divider">│</span>
                <span class="factor"></span>
            `;
            container.appendChild(finalStep);
            
            setTimeout(() => {
                finalStep.classList.add('visible');
            }, stepDelay);
            
            return stepDelay;
        }

        // Основная функция вычисления НОД
        function calculateGCD() {
            const num1 = parseInt(document.getElementById('number1').value);
            const num2 = parseInt(document.getElementById('number2').value);
            
            // Валидация
            const error = validateInput(num1, num2);
            if (error) {
                showError(error);
                return;
            }
            
            hideError();
            
            // Нахождение множителей
            const factors1 = factorize(num1);
            const factors2 = factorize(num2);
            const commonFactors = findCommonFactors(factors1, factors2);
            
            // Отображение результатов
            const resultSection = document.getElementById('resultSection');
            resultSection.style.display = 'block';
            
            // Разложение первого числа
            const delay1 = displayFactorization(num1, factors1, 'factorization1', commonFactors);
            
            // Разложение второго числа
            const delay2 = displayFactorization(num2, factors2, 'factorization2', commonFactors);
            
            // Строка с умножением
            const maxDelay = Math.max(delay1, delay2);
            setTimeout(() => {
                const multLine = document.getElementById('multiplicationLine');
                const factors1Str = factors1.join(' · ');
                const factors2Str = factors2.join(' · ');
                multLine.innerHTML = `<strong>${num1}</strong> = ${factors1Str}<br><strong>${num2}</strong> = ${factors2Str}`;
                multLine.classList.add('visible');
            }, maxDelay + 500);
            
            // Итоговый результат
            setTimeout(() => {
                const resultBox = document.getElementById('resultBox');
                if (commonFactors.length === 0) {
                    resultBox.innerHTML = `НОД(${num1}, ${num2}) = 1<br><small>Числа взаимно простые</small>`;
                } else {
                    const gcd = commonFactors.reduce((a, b) => a * b, 1);
                    const commonStr = commonFactors.join(' · ');
                    resultBox.innerHTML = `НОД(${num1}, ${num2}) = ${commonStr} = <strong>${gcd}</strong>`;
                }
                resultBox.classList.add('visible');
            }, maxDelay + 1500);
        }

        // Показать ошибку
        function showError(message) {
            const errorDiv = document.getElementById('errorMessage');
            errorDiv.textContent = message;
            errorDiv.style.display = 'block';
            document.getElementById('resultSection').style.display = 'none';
        }

        // Скрыть ошибку
        function hideError() {
            document.getElementById('errorMessage').style.display = 'none';
        }

        // Очистить всё
        function clearAll() {
            document.getElementById('number1').value = '';
            document.getElementById('number2').value = '';
            document.getElementById('resultSection').style.display = 'none';
            hideError();
        }

        // Показать пример
        function showExample() {
            const examples = [
                [84, 126],
                [48, 180],
                [56, 98],
                [120, 200],
                [45, 75],
                [64, 96],
                [35, 49],
                [144, 216]
            ];
            
            const randomExample = examples[Math.floor(Math.random() * examples.length)];
            document.getElementById('number1').value = randomExample[0];
            document.getElementById('number2').value = randomExample[1];
            calculateGCD();
        }

        // Обработка Enter
        document.getElementById('number1').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') calculateGCD();
        });
        
        document.getElementById('number2').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') calculateGCD();
        });
    </script>
</body>
</html>
